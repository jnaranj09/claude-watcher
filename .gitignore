node_modules
dist
out
.DS_Store
.eslintcache
*.log*
# Story 0.3 — incremental typecheck caches (PostToolUse hook + tsc --incremental).
*.tsbuildinfo

# Playwright-Electron e2e artifacts (screenshots, traces) — regenerable, never tracked.
test-results/

# BMAD tooling — method skill library + config/scripts (regenerable, not project code).
.claude/skills/
_bmad/

# BMAD planning/implementation record — NOT tracked. This repo is public, and those
# artifacts carry the operator's home paths, work email, and internal project names from
# the environment they were written in. They stay on disk locally; they do not ship.
# (One hand-checked exception is already tracked: the UX DESIGN.md, which is clean.)
_bmad-output/

# Superpowers planning/spec documents — local working records, never tracked/pushed
# (same reasoning as _bmad-output: operator-environment detail, not project code).
docs/superpowers/

# Personal per-project Claude overrides (the shared .claude/settings.json IS tracked).
.claude/settings.local.json

# Liquid Glass wallpaper sources (fetched by src/wallpapers.py --photos; not redistributed raw)
docs/themes/examples/liquid-glass/src/*.jpg
