{
  // Story 0.3 — typecheck coverage for the TEST + FIXTURE files (the harness's
  // compiler-as-QA must cover the fixtures + Vitest tests, which the build
  // tsconfigs intentionally do NOT include so they never ship in the bundle).
  //
  // It extends the web (jsdom/DOM-libs) base so renderer-ish tests typecheck, and
  // it carries the SAME strict flags as the build projects (AC-1 applies here too).
  // Run via `npm run typecheck` after the node + web projects.
  "extends": "@electron-toolkit/tsconfig/tsconfig.web.json",
  "include": [
    "src/__fixtures__/**/*",
    "src/**/*.test.ts",
    "src/**/*.test.tsx",
    "src/renderer/src/test/**/*",
    // Story 1.4 — the renderer's ambient `Window` augment (window.pty / window.watch)
    // so renderer component tests that touch the bridges typecheck under this program
    // (the web build program already includes env.d.ts; this program did not).
    "src/renderer/src/env.d.ts",
    "tests/unit/**/*",
    "tests/main/**/*",
    "tests/e2e/**/*"
  ],
  "compilerOptions": {
    "composite": false,
    "noEmit": true,
    "jsx": "react-jsx",
    "baseUrl": ".",
    // `vite/client` provides the ambient `*.module.css` module declaration so the
    // renderer COMPONENT tests (which import scoped CSS Modules) typecheck under
    // this program — the web build program gets the same via env.d.ts. [Story 1.3]
    "types": ["node", "vitest/globals", "vite/client"],
    "paths": {
      "@renderer/*": ["src/renderer/src/*"]
    },
    "strict": true,
    "noImplicitAny": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true
  }
}
