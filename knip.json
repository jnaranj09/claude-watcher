{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "entry": ["tests/**/*.{ts,mjs}", "eslint-rules/*.js"],
  "project": ["src/**/*.{ts,tsx}", "tests/**/*.{ts,mjs}", "eslint-rules/**/*.js"],
  "ignoreExportsUsedInFile": true,
  "ignoreDependencies": ["swagger-ui-dist"],
  "ignoreBinaries": ["pgrep"],
  "rules": {
    "types": "off"
  }
}
