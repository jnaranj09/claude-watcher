{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "entry": ["tests/**/*.{ts,mjs}", "eslint-rules/*.js", "src/mod/*/hooks/register.ts"],
  "project": ["src/**/*.{ts,tsx}", "tests/**/*.{ts,mjs}", "eslint-rules/**/*.js"],
  "ignoreExportsUsedInFile": true,
  "ignoreDependencies": ["swagger-ui-dist", "claude-code"],
  "ignoreBinaries": ["kwin_wayland", "ss", "mkfifo"],
  "rules": {
    "types": "off"
  }
}
