{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "node .claude/hooks/spec-copy-table.mjs",
            "timeout": 10,
            "statusMessage": "Spec Copy table check"
          },
          {
            "type": "command",
            "command": "node .claude/hooks/spec-taste-line.mjs",
            "timeout": 10,
            "statusMessage": "Spec Taste line check"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/typecheck-lint.sh\"",
            "timeout": 60,
            "statusMessage": "Typecheck + lint on changed file"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/run-tests-on-stop.sh\"",
            "timeout": 180,
            "statusMessage": "Running tests (npm test)"
          }
        ]
      }
    ]
  }
}
