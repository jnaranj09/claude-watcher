{
  "$schema": "https://raw.githubusercontent.com/jnaranj09/claude-watcher/main/docs/themes/theme.schema.json",
  "version": 1,
  "name": "Liquid Glass",
  "author": "claude-watcher",
  "colorScheme": "dark",
  "tokens": {
    "bg-base": "#141a2c",
    "bg-surface": "rgba(255,255,255,0.06)",
    "bg-surface-raised": "rgba(255,255,255,0.10)",
    "bg-col-hero": "rgba(255,207,41,0.06)",
    "bg-col-calm": "rgba(255,255,255,0.03)",
    "bg-card-hero": "rgba(255,255,255,0.12)",
    "bg-card-calm": "rgba(255,255,255,0.08)",
    "bg-row-rest": "rgba(255,255,255,0.10)",
    "bg-terminal": "rgba(10,12,20,0.55)",
    "scrim": "rgba(5,8,16,0.5)",
    "border": "rgba(255,255,255,0.14)",
    "border-strong": "rgba(255,255,255,0.28)",
    "border-card": "rgba(255,255,255,0.18)",
    "text-primary": "#f2f4f8",
    "text-secondary": "#c3c8d4",
    "text-muted": "#8a90a0",
    "text-dim": "#5b6070",
    "rounded-sm": "8px",
    "rounded-md": "12px",
    "rounded-lg": "18px",
    "shadow-dialog": "0 24px 64px rgba(0,0,0,0.45)",
    "shadow-pop": "0 12px 32px rgba(0,0,0,0.35)"
  },
  "terminal": {
    "background": "rgba(0,0,0,0)",
    "allowTransparency": true,
    "selectionBackground": "rgba(255,255,255,0.25)"
  },
  "css": "theme.css"
}
