{
  "$schema": "https://raw.githubusercontent.com/jnaranj09/claude-watcher/main/docs/themes/theme.schema.json",
  "version": 1,
  "name": "Liquid Glass",
  "author": "claude-watcher",
  "colorScheme": "dark",
  "tokens": {
    "bg-base": "transparent",
    "bg-surface": "rgba(255,255,255,0.06)",
    "bg-surface-raised": "rgba(255,255,255,0.10)",
    "bg-col-hero": "rgba(255,207,41,0.06)",
    "bg-col-calm": "rgba(255,255,255,0.03)",
    "bg-card-hero": "rgba(255,255,255,0.12)",
    "bg-card-calm": "rgba(255,255,255,0.08)",
    "bg-row-rest": "rgba(255,255,255,0.10)",
    "bg-terminal": "rgba(12,12,13,0.58)",
    "scrim": "rgba(0,0,0,0.45)",
    "border": "rgba(255,255,255,0.14)",
    "border-strong": "rgba(255,255,255,0.28)",
    "border-card": "rgba(255,255,255,0.18)",
    "text-primary": "#ffffff",
    "text-secondary": "rgba(235,235,245,0.8)",
    "text-muted": "rgba(235,235,245,0.78)",
    "text-dim": "rgba(235,235,245,0.4)",
    "idle": "#9a9aa0",
    "rounded-sm": "8px",
    "rounded-md": "12px",
    "rounded-lg": "20px",
    "gutter": "16px",
    "shadow-dialog": "0 30px 70px rgba(0,0,0,0.55)",
    "shadow-pop": "0 20px 48px rgba(0,0,0,0.5)",
    "workspace-slate-fill": "rgba(127, 132, 156, 0.14)",
    "workspace-slate-border": "rgba(127, 132, 156, 0.40)",
    "workspace-blue-fill": "rgba(137, 180, 250, 0.14)",
    "workspace-blue-border": "rgba(137, 180, 250, 0.40)",
    "workspace-green-fill": "rgba(166, 227, 161, 0.14)",
    "workspace-green-border": "rgba(166, 227, 161, 0.40)",
    "workspace-amber-fill": "rgba(249, 226, 175, 0.14)",
    "workspace-amber-border": "rgba(249, 226, 175, 0.40)",
    "workspace-violet-fill": "rgba(203, 166, 247, 0.14)",
    "workspace-violet-border": "rgba(203, 166, 247, 0.40)",
    "workspace-rose-fill": "rgba(243, 139, 168, 0.14)",
    "workspace-rose-border": "rgba(243, 139, 168, 0.40)",
    "workspace-red-fill": "rgba(242, 135, 121, 0.14)",
    "workspace-red-border": "rgba(242, 135, 121, 0.40)",
    "workspace-lime-fill": "rgba(194, 223, 124, 0.14)",
    "workspace-lime-border": "rgba(194, 223, 124, 0.40)",
    "workspace-teal-fill": "rgba(148, 226, 213, 0.14)",
    "workspace-teal-border": "rgba(148, 226, 213, 0.40)",
    "workspace-cyan-fill": "rgba(137, 220, 235, 0.14)",
    "workspace-cyan-border": "rgba(137, 220, 235, 0.40)",
    "workspace-indigo-fill": "rgba(158, 163, 247, 0.14)",
    "workspace-indigo-border": "rgba(158, 163, 247, 0.40)",
    "workspace-pink-fill": "rgba(245, 194, 231, 0.14)",
    "workspace-pink-border": "rgba(245, 194, 231, 0.40)"
  },
  "terminal": {
    "background": "rgba(0,0,0,0)",
    "allowTransparency": true,
    "selectionBackground": "rgba(255,255,255,0.25)"
  },
  "css": "theme.css",
  "wallpapers": [
    { "id": "lake", "name": "Lake", "file": "lake.webp" },
    { "id": "bridge", "name": "Bridge", "file": "bridge.webp" },
    { "id": "subway", "name": "Subway", "file": "subway.webp" },
    { "id": "graphite", "name": "Graphite", "file": "graphite.webp" },
    { "id": "aurora", "name": "Aurora gradient", "file": "aurora.webp" },
    { "id": "smoke", "name": "Warm smoke", "file": "smoke.webp" }
  ],
  "glass": {
    "renderer": "webgl",
    "surfaces": {
      "header": {
        "refract": 14,
        "edge": 16,
        "blur": 12,
        "chroma": 0.25,
        "tint": "#0e0e10",
        "tintAmount": 0.3,
        "rim": 0.3,
        "exposure": 2.0,
        "lift": 0.03,
        "glow": 0.018,
        "lightFollowsCursor": false
      },
      "column": {
        "refract": 18,
        "edge": 24,
        "blur": 16,
        "chroma": 0.2,
        "tint": "#0e0e10",
        "tintAmount": 0.25,
        "rim": 0.26,
        "exposure": 1.9,
        "lift": 0.02,
        "glow": 0.008,
        "tintNeedsYou": "#2a2414",
        "lightFollowsCursor": false
      },
      "card": {
        "refract": 8,
        "edge": 12,
        "blur": 8,
        "chroma": 0.15,
        "tint": "#0e0e10",
        "tintAmount": 0.36,
        "rim": 0.26,
        "exposure": 1.8,
        "lift": 0.02,
        "glow": 0.012,
        "lightFollowsCursor": true
      },
      "control": {
        "refract": 5,
        "edge": 9,
        "blur": 6,
        "chroma": 0.2,
        "tint": "#0e0e10",
        "tintAmount": 0.22,
        "rim": 0.27,
        "exposure": 2.0,
        "lift": 0.04,
        "glow": 0.015,
        "lightFollowsCursor": true
      },
      "field": {
        "refract": 5,
        "edge": 9,
        "blur": 6,
        "chroma": 0.2,
        "tint": "#0e0e10",
        "tintAmount": 0.4,
        "rim": 0.27,
        "exposure": 2.0,
        "lift": 0.04,
        "glow": 0.015,
        "lightFollowsCursor": true
      }
    }
  }
}
