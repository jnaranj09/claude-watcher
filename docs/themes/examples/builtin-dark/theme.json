  "terminal": {
    "background": "#141312",
    "foreground": "#d6d3ca",
    "cursor": "#d6d3ca",
    "cursorAccent": "#141312",
    "selectionBackground": "rgba(60,58,48,0.85)",
    "black": "#1a1a18",
    "red": "#f38ba8",
    "green": "#a6e3a1",
    "yellow": "#f9e2af",
    "blue": "#89b4fa",
    "magenta": "#cba6f7",
    "cyan": "#94e2d5",
    "white": "#a4a094",
    "brightBlack": "#47453d",
    "brightRed": "#f38ba8",
    "brightGreen": "#a6e3a1",
    "brightYellow": "#f9e2af",
    "brightBlue": "#89b4fa",
    "brightMagenta": "#cba6f7",
    "brightCyan": "#94e2d5",
    "brightWhite": "#d6d3ca"
