{
  "$schema": "https://raw.githubusercontent.com/jnaranj09/claude-watcher/main/docs/themes/theme.schema.json",
  "version": 1,
  "name": "Built-in dark",
  "author": "claude-watcher",
  "colorScheme": "dark",
  "tokens": {
    "bg-base": "#1a1a18",
    "bg-surface": "#232220",
    "bg-surface-raised": "#2c2b27",
    "bg-col-hero": "#201f1c",
    "bg-col-calm": "#151513",
    "bg-card-hero": "#2a2925",
    "bg-card-calm": "#1e1e1b",
    "bg-row-rest": "#3a3833",
    "bg-terminal": "#141312",
    "scrim": "rgba(10,10,8,0.62)",
